# Copy to .env for local dev. Real values live in Render/Railway's env config in prod — never committed.

ENV=local

# Postgres connection the API uses for ordinary (RLS-respecting) queries.
# Local dev (infra/docker-compose.yml): postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
# Prod: Supabase project's pooled connection string, SESSION mode (not transaction mode —
# transaction-mode poolers break the `SET LOCAL` scoping the RLS session pattern relies on).
# The connecting role must be able to `SET ROLE authenticated` (Supabase's default
# `postgres` role can; a custom least-privilege role would need explicit GRANT
# authenticated TO <role>) — app/db/session.py issues that SET on every request so
# RLS is enforced even though the connection string itself may be more privileged.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Same database, but authenticated as a role that can act as service_role for the
# narrow set of genuinely cross-user admin operations (invite redemption pre-session).
# Never used for ordinary per-user requests. See docs/architecture/database-schema.md §9.
DATABASE_URL_ADMIN=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase project settings (Settings -> API in the Supabase dashboard).
# JWT verification uses this URL's JWKS endpoint (auth/v1/.well-known/jwks.json)
# directly -- see app/core/security.py. No shared JWT secret needed: Supabase
# now signs tokens with rotatable asymmetric keys (ES256), verified against
# the public keys fetched from that endpoint, not a static secret.
SUPABASE_URL=https://your-project.supabase.co
# Used ONLY by app/integrations/storage.py to write into the private, per-user-
# path-scoped garment-images bucket — never for ordinary DB queries (those go
# through DATABASE_URL's RLS-respecting path). Keep this out of the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of emails permitted to create invites (i.e. you).
# This is the entire "admin" model for an invite-only, single-developer-run app —
# no separate roles table needed at this scale.
ADMIN_EMAILS=you@example.com

# Shared secret the GitHub Actions cron workflow sends in an `X-Cron-Secret` header
# to hit /internal/cron/* endpoints. Generate with `openssl rand -hex 32`.
CRON_SHARED_SECRET=change-me

# Gemini API key (free tier) — added in Phase 1 when the ingestion pipeline lands.
GEMINI_API_KEY=

# OpenWeatherMap free tier (docs/tech-stack-justification.md). Optional: the
# Stylist's get_weather tool degrades gracefully (returns "unavailable") rather
# than erroring if this is unset — see app/integrations/weather.py.
OPENWEATHERMAP_API_KEY=

CORS_ORIGINS=http://localhost:3000
